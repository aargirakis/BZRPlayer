   if ((c >= 'A') && (c <= 'F')) return c - 'A' + 10;
   return -1;
 }
+
+char *identifyBufferFromConfig(const char *sididCfgPath, unsigned char *buffer, int length)
+{
+  readconfig((char *) sididCfgPath);
+
+  SIDID *id;
+  int found = 0;
+
+  if (!playerid) id = firstid;
+  else id = playerid;
+
+  while (id)
+  {
+    if (identifybuffer(id, buffer, length))
+    {
+      id->count++;
+      if (!found)
+      {
+        found = 1;
+        identified++;
+      }
+      if (!multiscan) break;
+    }
+    if (!playerid) id = (SIDID *)id->next;
+    else break;
+  }
+  if (!found)
+  {
+    unidentified++;
+    return "Unknown";
+  }
+  examined++;
+  return id->name;
+}
